<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robotic_arm">

  <xacro:property name="pi" value="3.141592653589793"/>
  <xacro:property name="base_h" value="0.08"/>
  <xacro:property name="l1" value="0.12"/>
  <xacro:property name="l2" value="0.15"/>
  <xacro:property name="l3" value="0.09"/>
  <xacro:property name="gripper_l" value="0.06"/>
  <xacro:property name="link_w" value="0.025"/>
  <xacro:property name="link_h" value="0.025"/>

  <material name="blue"><color rgba="0.12 0.35 0.75 1"/></material>
  <material name="orange"><color rgba="0.95 0.42 0.12 1"/></material>
  <material name="dark"><color rgba="0.18 0.20 0.23 1"/></material>
  <material name="silver"><color rgba="0.72 0.75 0.78 1"/></material>

  <link name="base_link">
    <visual><origin xyz="0 0 ${base_h/2}" rpy="0 0 0"/><geometry><cylinder radius="0.055" length="${base_h}"/></geometry><material name="dark"/></visual>
    <collision><origin xyz="0 0 ${base_h/2}"/><geometry><cylinder radius="0.055" length="${base_h}"/></geometry></collision>
    <inertial><origin xyz="0 0 ${base_h/2}"/><mass value="1.0"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>

  <link name="L1">
    <visual><origin xyz="${l1/2} 0 0"/><geometry><box size="${l1} ${link_w} ${link_h}"/></geometry><material name="blue"/></visual>
    <collision><origin xyz="${l1/2} 0 0"/><geometry><box size="${l1} ${link_w} ${link_h}"/></geometry></collision>
    <inertial><origin xyz="${l1/2} 0 0"/><mass value="0.25"/><inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003"/></inertial>
  </link>

  <link name="L2">
    <visual><origin xyz="${l2/2} 0 0"/><geometry><box size="${l2} ${link_w} ${link_h}"/></geometry><material name="orange"/></visual>
    <collision><origin xyz="${l2/2} 0 0"/><geometry><box size="${l2} ${link_w} ${link_h}"/></geometry></collision>
    <inertial><origin xyz="${l2/2} 0 0"/><mass value="0.22"/><inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.0004" iyz="0" izz="0.0004"/></inertial>
  </link>

  <link name="L3">
    <visual><origin xyz="${l3/2} 0 0"/><geometry><box size="${l3} ${link_w} ${link_h}"/></geometry><material name="blue"/></visual>
    <collision><origin xyz="${l3/2} 0 0"/><geometry><box size="${l3} ${link_w} ${link_h}"/></geometry></collision>
    <inertial><origin xyz="${l3/2} 0 0"/><mass value="0.16"/><inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00012" iyz="0" izz="0.00012"/></inertial>
  </link>

  <link name="end_effector">
    <visual><origin xyz="${gripper_l/2} 0 0"/><geometry><box size="${gripper_l} 0.018 0.018"/></geometry><material name="silver"/></visual>
    <collision><origin xyz="${gripper_l/2} 0 0"/><geometry><box size="${gripper_l} 0.018 0.018"/></geometry></collision>
    <inertial><origin xyz="${gripper_l/2} 0 0"/><mass value="0.08"/><inertia ixx="0.000005" ixy="0" ixz="0" iyy="0.00003" iyz="0" izz="0.00003"/></inertial>
  </link>

  <joint name="base_joint" type="revolute">
    <parent link="base_link"/><child link="L1"/>
    <origin xyz="0 0 ${base_h}" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="20" velocity="2.0"/>
    <dynamics damping="0.2" friction="0.1"/>
  </joint>

  <joint name="shoulder_joint" type="revolute">
    <parent link="L1"/><child link="L2"/>
    <origin xyz="${l1} 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="20" velocity="2.0"/>
    <dynamics damping="0.2" friction="0.1"/>
  </joint>

  <joint name="elbow_joint" type="revolute">
    <parent link="L2"/><child link="L3"/>
    <origin xyz="${l2} 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="15" velocity="2.0"/>
    <dynamics damping="0.2" friction="0.1"/>
  </joint>

  <joint name="wrist_joint" type="revolute">
    <parent link="L3"/><child link="end_effector"/>
    <origin xyz="${l3} 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="2.0"/>
    <dynamics damping="0.2" friction="0.1"/>
  </joint>

  <ros2_control name="GazeboSimSystem" type="system">
    <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
    <joint name="base_joint"><command_interface name="position"><param name="min">-3.14159</param><param name="max">3.14159</param></command_interface><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="shoulder_joint"><command_interface name="position"><param name="min">-1.57</param><param name="max">1.57</param></command_interface><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="elbow_joint"><command_interface name="position"><param name="min">-2.0</param><param name="max">2.0</param></command_interface><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="wrist_joint"><command_interface name="position"><param name="min">-1.57</param><param name="max">1.57</param></command_interface><state_interface name="position"/><state_interface name="velocity"/></joint>
  </ros2_control>

  <gazebo>
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find arm_description)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>
</robot>
